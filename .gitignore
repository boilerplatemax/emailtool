# ── Dependencies ───────────────────────────────────────────────
node_modules/

# ── Build output ───────────────────────────────────────────────
dist/
dist-ssr/

# ── Environment / secrets ──────────────────────────────────────
# .env.example is safe to commit (no real secrets).
# Everything else must stay local.
.env
.env.local
.env.*.local

# Supabase local dev files (contain service-role key)
supabase/.branches/
supabase/.temp/

# ── Editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ───────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Local data files ───────────────────────────────────────────
# Generated or imported CSVs live at the repo root by convention;
# they contain lead data and should never be committed.
/*.csv
