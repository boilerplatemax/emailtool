# ──────────────────────────────────────────────────────────────
# EmailTool — Environment Variables
# Copy to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────


# ── Supabase (frontend — safe to expose) ──────────────────────
# Found in: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── App Password (frontend) ────────────────────────────────────
# Simple gate for the browser UI. Also sent as x-app-password
# header to each Edge Function, which validates it server-side.
# Keep it strong — it IS committed to the Vite bundle.

VITE_APP_PASSWORD=change-me-before-deploy


# ── Email sender defaults (frontend — optional) ────────────────
# Pre-fills the sender name/email on the email compose forms.
# Users can still edit these in the UI.

VITE_SENDER_NAME=Jane Smith
VITE_SENDER_EMAIL=jane@example.com


# ══════════════════════════════════════════════════════════════
# !! EDGE FUNCTION SECRETS — never use VITE_ prefix for these !!
# These are set via the Supabase CLI and run server-side only.
# They are NEVER included in the Vite/browser bundle.
#
#   supabase secrets set APP_PASSWORD=your_secret
#   supabase secrets set SENDGRID_API_KEY=SG.xxxxxxxxxxxx
#   supabase secrets set SENDGRID_FROM_EMAIL=noreply@yourdomain.com
#   supabase secrets set SENDGRID_FROM_NAME="Your Org Name"
#
# Available inside Edge Functions as Deno.env.get("KEY_NAME").
# ══════════════════════════════════════════════════════════════
#
# APP_PASSWORD              Must match VITE_APP_PASSWORD above.
#
# SENDGRID_API_KEY          Full-Access API key from SendGrid.
#                           https://app.sendgrid.com/settings/api_keys
#                           ⚠️  NEVER prefix with VITE_ — this would leak
#                           the key to every browser that loads the app.
#
# SENDGRID_FROM_EMAIL       Verified sender email in your SendGrid account.
# SENDGRID_FROM_NAME        Display name used as the email "From" field.
#
# SUPABASE_URL              Auto-injected by Supabase Edge Function runtime.
# SUPABASE_SERVICE_ROLE_KEY Auto-injected by Supabase Edge Function runtime.
