# Copy to .env.local and fill in real values

# Supabase project URL and anon key (safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App password gate (embedded in bundle — internal tools only)
VITE_APP_PASSWORD=changeme

# ── Edge Function secrets (set via Supabase dashboard or CLI) ──
# These are NEVER in the frontend bundle
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SENDGRID_API_KEY=your-sendgrid-key
