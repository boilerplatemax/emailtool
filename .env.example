# ──────────────────────────────────────────────────────────────
# EmailTool — Environment Variables
# Copy to .env.local and fill in real values.
# ──────────────────────────────────────────────────────────────

# ── Frontend (Vite) — embedded in browser bundle ──────────────
# These values are visible to anyone who inspects the JS bundle.
# Only put non-secret values here.

# Supabase project URL (safe — it's the public endpoint)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe — Row Level Security enforces access)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: pre-fill sender name/email on all email forms
VITE_SENDER_NAME=Jane Smith
VITE_SENDER_EMAIL=jane@example.com

# App password sent as x-app-password header to Edge Functions.
# The real authoritative check happens server-side against APP_PASSWORD.
VITE_APP_PASSWORD=change-me-before-deploy


# ── Edge Function secrets — set via Supabase CLI, never in frontend ──
#
#   supabase secrets set APP_PASSWORD=your_secret
#   supabase secrets set SENDGRID_API_KEY=SG.xxxxxxxxxxxx
#
# These are available as Deno.env.get(...) inside Edge Functions.
# They are NEVER included in the Vite build output.
#
# APP_PASSWORD              Must match VITE_APP_PASSWORD above.
# SENDGRID_API_KEY          Full Access API key from SendGrid dashboard.
# SUPABASE_URL              Auto-injected by Supabase runtime.
# SUPABASE_SERVICE_ROLE_KEY Auto-injected by Supabase runtime.
